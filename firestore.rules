rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Shared store data — products, categories, banners, settings, orders, plans
    match /store/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // User profiles (role, isApproved, etc.)
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Per-user data (cart, orders, address, profile, subscription, etc.)
    match /users/{uid}/data/{key} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Rider job applications — rider writes their own, only admin reads/deletes
    match /riderApplications/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow read, delete: if isAdmin();
    }
  }
}

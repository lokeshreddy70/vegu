generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  VENDOR
  DELIVERY
  ADMIN
  OWNER
  STORE_MANAGER
  INVENTORY_MANAGER
  PACKING_STAFF
  SUPPORT_STAFF
}

enum StaffStatus {
  ACTIVE
  BLOCKED
}

enum OpsOrderStage {
  CUSTOMER_ORDERED
  STORE_RECEIVED
  STORE_ACCEPTED
  PACKING_STARTED
  PACKED
  BARCODE_GENERATED
  RIDER_ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum InventoryAdjustmentType {
  STOCK_IN
  STOCK_OUT
  WASTAGE
  EXPIRED
  DAMAGED
  MANUAL_CORRECTION
}

enum ChatSenderRole {
  CUSTOMER
  RIDER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  STRIPE
  RAZORPAY
  WALLET
  COD
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DeliveryStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum RiderVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketCategory {
  ORDER
  DELIVERY
  PAYMENT
  REFUND
  ACCOUNT
  RIDER
  INVENTORY
  STORE_OPERATIONS
  GENERAL
}

enum SupportSenderRole {
  CUSTOMER
  RIDER
  ADMIN
  AI
  SYSTEM
}

// ─── Models ────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  name          String
  avatar        String?
  password      String
  role          Role      @default(CUSTOMER)
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  googleId      String?   @unique

  refreshTokens   RefreshToken[]
  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  notifications   Notification[]
  wallet          Wallet?
  vendor          Vendor?
  deliveryPartner DeliveryPartner?
  riderRatings    RiderRating[]
  favoriteRiders  FavoriteRider[]
  supportTickets  SupportTicket[]       @relation("SupportRequester")
  assignedTickets SupportTicket[]       @relation("SupportAssignee")
  supportMessages SupportTicketMessage[]
  staffProfile    StaffProfile?
  managedStore    Store?                @relation("StoreManager")
  packedOrders    Order[]               @relation("OrderPackedBy")
  activityLogs    ActivityLog[]         @relation("ActivityActor")
  createdStaff    StaffProfile[]        @relation("StaffCreatedBy")
  inventoryAdjustments InventoryAdjustment[] @relation("InventoryAdjustedBy")
  resetTokens     PasswordResetToken[]
  orderChatMessages OrderChatMessage[]

  loyaltyPoints Int    @default(0)
  referralCode  String @unique @default(cuid())
  referredBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String  @default("Home")
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String  @default("India")
  isDefault Boolean @default(false)
  lat       Float?
  lng       Float?
  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  icon        String?
  color       String?
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@map("categories")
}

model Product {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  brand        String?
  description  String?
  price        Float
  comparePrice Float?
  images       String[]
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])
  supplierName String?
  sku          String?  @unique
  stock        Int      @default(0)
  minStockAlert Int     @default(10)
  unit         String   @default("piece")
  weight       Float?
  purchasePrice Float?
  batchNumber  String?
  expiryDate   DateTime?
  discount     Float    @default(0)
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  isAvailable  Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  isTrending   Boolean  @default(false)
  tags         String[]

  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  adjustments   InventoryAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([vendorId])
  @@index([storeId])
  @@index([slug])
  @@index([isAvailable, isFeatured])
  @@index([stock])
  @@index([isAvailable, stock])
  @@map("products")
}

model Vendor {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName   String
  storeSlug   String       @unique
  description String?
  logo        String?
  banner      String?
  phone       String?
  email       String?
  businessName String?
  address      String?
  gstNumber    String?
  paymentDetails Json?
  suppliedProducts String[]
  storeId      String?
  store        Store?       @relation(fields: [storeId], references: [id])
  status      VendorStatus @default(PENDING)
  isActive    Boolean      @default(false)
  rating      Float        @default(0)
  totalSales  Float        @default(0)
  products    Product[]
  orders      Order[]
  wallet      VendorWallet?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vendors")
}

model DeliveryPartner {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType     String         @default("bike")
  vehicleNo       String?
  isVerified      Boolean        @default(false)
  verificationStatus RiderVerificationStatus @default(PENDING)
  profilePhoto    String?        @db.Text
  drivingLicense  String?        @db.Text
  aadhaarPhoto    String?        @db.Text
  rcDocument      String?        @db.Text
  insuranceDocument String?      @db.Text
  status          DeliveryStatus @default(OFFLINE)
  rating          Float          @default(0)
  ratingCount     Int            @default(0)
  totalDeliveries Int            @default(0)
  totalEarnings   Float          @default(0)
  currentLat      Float?
  currentLng      Float?
  deliveries      Order[]
  riderRatings    RiderRating[]
  favoritedBy     FavoriteRider[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@map("delivery_partners")
}

model Order {
  id                String     @id @default(cuid())
  orderNumber       String     @unique
  userId            String
  user              User       @relation(fields: [userId], references: [id])
  vendorId          String?
  vendor            Vendor?    @relation(fields: [vendorId], references: [id])
  storeId           String?
  store             Store?     @relation(fields: [storeId], references: [id])
  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  addressId         String?
  address           Address?   @relation(fields: [addressId], references: [id])
  items             OrderItem[]
  status            OrderStatus   @default(PENDING)
  opsStage          OpsOrderStage @default(STORE_RECEIVED)
  paymentStatus     PaymentStatus @default(PENDING)
  paymentMethod     PaymentMethod @default(COD)
  paymentId         String?
  subtotal          Float
  deliveryFee       Float      @default(40)
  discount          Float      @default(0)
  total             Float
  couponCode        String?
  notes             String?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  packingStartedAt  DateTime?
  packedAt          DateTime?
  packingBarcode    String?
  packedByStaffId   String?
  packedByStaff     User?       @relation("OrderPackedBy", fields: [packedByStaffId], references: [id])
  trackingHistory   Json[]
  supportTickets    SupportTicket[]
  chatMessages      OrderChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([vendorId])
  @@index([status])
  @@index([opsStage])
  @@index([orderNumber])
  @@index([storeId])
  @@index([paymentId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  image     String?
  price     Float
  quantity  Int
  total     Float

  @@index([orderId])
  @@map("order_items")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Review {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating     Int
  title      String?
  comment    String?
  images     String[]
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  discountType  String    @default("percentage")
  discountValue Float
  minOrderValue Float     @default(0)
  maxDiscount   Float?
  usageLimit    Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?

  createdAt DateTime @default(now())

  @@map("coupons")
}

model Wallet {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Float         @default(0)
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

model VendorWallet {
  id           String        @id @default(cuid())
  vendorId     String        @unique
  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  balance      Float         @default(0)
  totalEarned  Float         @default(0)
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vendor_wallets")
}

model Transaction {
  id             String          @id @default(cuid())
  walletId       String?
  wallet         Wallet?         @relation(fields: [walletId], references: [id])
  vendorWalletId String?
  vendorWallet   VendorWallet?   @relation(fields: [vendorWalletId], references: [id])
  type           TransactionType
  amount         Float
  description    String
  reference      String?

  createdAt DateTime @default(now())

  @@map("transactions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  data      Json?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model SupportTicket {
  id                 String                @id @default(cuid())
  userId             String?
  user               User?                 @relation("SupportRequester", fields: [userId], references: [id], onDelete: SetNull)
  assignedAdminId    String?
  assignedAdmin      User?                 @relation("SupportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  orderId            String?
  order              Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  title              String
  summary            String                @db.Text
  category           SupportTicketCategory @default(GENERAL)
  priority           SupportTicketPriority @default(MEDIUM)
  status             SupportTicketStatus   @default(OPEN)
  sourceRole         SupportSenderRole     @default(CUSTOMER)
  sourceChannel      String                @default("app-chat")
  requestedAction    String?
  tags               String[]
  metadata           Json?
  aiSuggestedReply   String?               @db.Text
  aiConfidence       Float?
  lastMessagePreview String?               @db.Text
  resolvedAt         DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  messages           SupportTicketMessage[]

  @@index([userId, status])
  @@index([orderId])
  @@index([status, priority, createdAt])
  @@index([assignedAdminId])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id          String            @id @default(cuid())
  ticketId    String
  ticket      SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String?
  sender      User?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderRole  SupportSenderRole
  body        String            @db.Text
  attachments Json?
  createdAt   DateTime          @default(now())

  @@index([ticketId, createdAt])
  @@index([senderId])
  @@map("support_ticket_messages")
}

model Banner {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  image      String
  link       String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}


model RiderRating {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryPartnerId String
  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)
  orderId           String          @unique
  rating            Int
  comment           String?

  createdAt DateTime @default(now())

  @@unique([userId, orderId])
  @@index([deliveryPartnerId])
  @@map("rider_ratings")
}

model FavoriteRider {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryPartnerId String
  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, deliveryPartnerId])
  @@index([userId])
  @@map("favorite_riders")
}

model DeliveryProof {
  id          String   @id @default(cuid())
  orderId     String   @unique
  riderId     String
  imageBase64 String   @db.Text
  lat         Float?
  lng         Float?
  address     String?
  capturedAt  DateTime @default(now())

  @@index([riderId])
  @@map("delivery_proofs")
}

model Store {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  code       String   @unique
  city       String
  state      String
  address    String?
  phone      String?
  isActive   Boolean  @default(true)
  managerId  String?  @unique
  manager    User?    @relation("StoreManager", fields: [managerId], references: [id], onDelete: SetNull)
  staff      StaffProfile[]
  products   Product[]
  orders     Order[]
  vendors    Vendor[]
  adjustments InventoryAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([isActive])
  @@map("stores")
}

model StaffProfile {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  employeeCode String      @unique
  status       StaffStatus @default(ACTIVE)
  createdById  String?
  createdBy    User?       @relation("StaffCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId, status])
  @@map("staff_profiles")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model ActivityLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  module      String
  action      String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([module, createdAt])
  @@index([actorUserId, createdAt])
  @@map("activity_logs")
}

model InventoryAdjustment {
  id          String                  @id @default(cuid())
  productId   String
  product     Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type        InventoryAdjustmentType
  quantity    Int
  reason      String?
  createdById String?
  createdBy   User?                   @relation("InventoryAdjustedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime                @default(now())

  @@index([storeId, type, createdAt])
  @@index([productId, createdAt])
  @@map("inventory_adjustments")
}

model OrderChatMessage {
  id         String         @id @default(cuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole ChatSenderRole
  message    String         @db.Text
  createdAt  DateTime       @default(now())

  @@index([orderId, createdAt])
  @@index([senderId, createdAt])
  @@map("order_chat_messages")
}

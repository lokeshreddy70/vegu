# ─── Database (Neon / Supabase / Railway PostgreSQL) ──────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vegu?schema=public&sslmode=require"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-app.vercel.app

# ─── JWT (generate with: openssl rand -base64 48) ────────────────────────────
JWT_ACCESS_SECRET=REPLACE_WITH_48_CHAR_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_48_CHAR_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Cloudinary (https://cloudinary.com) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Razorpay (https://razorpay.com/docs/) ───────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXX

# ─── Stripe (https://stripe.com) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_XXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXX

# ─── Email (SMTP / SendGrid / Resend) ────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.XXXXXXXX
FROM_EMAIL=noreply@yourdomain.com
